/* Visit https://www.typescriptlang.org/tsconfig/ to learn about this file */
{
  "compilerOptions": {
    /* Basic configuration */
    "lib": ["ES2024"],
    "module": "node18",
    "skipLibCheck": true,

    /* Support the use of type stripping in Node */
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,

    /* Monorepo: resolve @gamenite/shared for IDE + ESLint (typescript-eslint projectService) */
    "baseUrl": ".",
    "paths": {
      "@gamenite/shared": ["../shared/src/index.ts"],
      "@gamenite/shared/*": ["../shared/src/*"]
    },

    /* Linting */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
